@page "/notes"
@inject GoogleDriveService DriveService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<AppPageTitle Title="Notes" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom>Budget Notes</MudText>

    <!-- Add New Note -->
    <MudTextField @bind-Value="newNoteContent" 
                  Label="Write a new note..." 
                  Variant="Variant.Outlined" 
                  Lines="3"
                  Class="mt-2" />

    <MudButton OnClick="AddNote" 
               Color="Color.Primary" 
               Variant="Variant.Filled" 
               StartIcon="@Icons.Material.Filled.Add"
               Class="mt-3">
        Add Note
    </MudButton>

    <!-- Notes List -->
    <MudCard Class="mt-6">
        <MudCardHeader>
            <MudText Typo="Typo.h6">Notes (@budget.Notes.Count)</MudText>
        </MudCardHeader>
        <MudCardContent>
            @if (budget.Notes.Any())
            {
                <MudList Dense="true" T="Budget">
                    @foreach (var note in budget.Notes.OrderByDescending(n => n.Date))
                    {
                        <MudListItem>
                            <div class="d-flex justify-space-between align-center">
                                <div style="flex: 1;">
                                    <MudText Typo="Typo.body1">@note.Content</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Primary">
                                        @note.Date.ToLocalTime().ToString("f")
                                    </MudText>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Color="Color.Error" 
                                               Size="Size.Small"
                                               OnClick="() => DeleteNote(note)" />
                            </div>
                        </MudListItem>
                        <MudDivider />
                    }
                </MudList>
            }
            else
            {
                <MudText Color="Color.Primary" Class="pa-4 text-center">
                    No notes yet. Add your first budget note above.
                </MudText>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private Budget budget => DriveService.CurrentBudget;
    private string newNoteContent = "";

    protected override async Task OnInitializedAsync()
    {
        await DriveService.LoadAsync();
        DriveService.OnBudgetChanged += StateHasChanged;
    }

    private async Task AddNote()
    {
        if (string.IsNullOrWhiteSpace(newNoteContent)) return;

        budget.Notes.Add(new BudgetNote
        {
            Content = newNoteContent.Trim(),
            Date = DateTime.UtcNow
        });

        newNoteContent = "";
        await DriveService.SaveAsync();
        Snackbar.Add("Note added", Severity.Success);
    }

    private async Task DeleteNote(BudgetNote note)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Note",
            $"Are you sure you want to delete this note?\n\n\"{note.Content.Substring(0, Math.Min(80, note.Content.Length))}{(note.Content.Length > 80 ? "..." : "")}\"",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            budget.Notes.Remove(note);
            await DriveService.SaveAsync();
            Snackbar.Add("Note deleted", Severity.Info);
        }
    }
}